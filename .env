# Variable names must match what src/config.js reads. config.js is the only
# place that touches import.meta.env; everything else imports from it.

# REST base, including the /api/v1 prefix. Leave unset to run against the
# in-browser mock inbox (see USE_MOCK in src/config.js).
# VITE_API_BASE='https://a443ee35-b521-4209-bc8d-0e974b3f97ab.mock.pstmn.io/api/v1'

# WebSocket origin, NOT under /api/v1. Derived from VITE_API_BASE when blank.
VITE_WS_BASE=''

# Force the mock on even when VITE_API_BASE is set.
# VITE_USE_MOCK='true'
