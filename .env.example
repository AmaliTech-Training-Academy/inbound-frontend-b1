# Copy to .env and fill in as needed:  cp .env.example .env
#
# These are the only variables the app reads, and src/config.js is the only
# file that reads them — everything else imports from it. Names must match
# config.js exactly; a mismatched name is silently ignored by Vite.

# REST base, including the /api/v1 prefix.
# Leave unset to run against the in-browser mock inbox.
# VITE_API_BASE='http://localhost:3000/api/v1'

# WebSocket origin. NOT under /api/v1 — it is a separate origin in some
# deployments. Derived from VITE_API_BASE when left blank.
VITE_WS_BASE=''

# Force the in-memory mock on even when VITE_API_BASE is set.
# VITE_USE_MOCK='true'
