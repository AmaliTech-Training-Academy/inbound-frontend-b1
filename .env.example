# Copy to .env before running:  cp .env.example .env
#
# These are the only variables the app reads. src/config.js is the only file
# that reads them; everything else imports from it. Names must match config.js
# exactly - Vite silently ignores a mismatched name.

# REST base, including the /api/v1 prefix.
#
# Defaults to http://localhost:9001/api/v1 (the server block in the API's
# OpenAPI spec) when unset, so running the backend locally needs no .env.
# For the deployed instance, uncomment this instead:
# VITE_API_BASE='https://54.73.161.140.nip.io/server/api/v1'

# Socket.IO origin. Derived from VITE_API_BASE when left blank, which is
# almost always what you want: REST and the socket share one origin, and any
# path prefix (e.g. /server) is handled for you.
# VITE_WS_BASE=''

# Run against the in-browser mock inbox instead of a real backend.
#
# Opt-in ONLY. Without this the app talks to VITE_API_BASE and fails visibly
# if nothing is there, rather than silently serving invented inboxes.
# VITE_USE_MOCK='true'
