# Copy to .env and fill in as needed:  cp .env.example .env
#
# These are the only variables the app reads, and src/config.js is the only
# file that reads them — everything else imports from it. Names must match
# config.js exactly; a mismatched name is silently ignored by Vite.

# REST base, including the /api/v1 prefix. Required to reach a backend: without
# it (and without VITE_USE_MOCK) the app says it isn't connected. Vite reads it
# at build time, so a Docker build needs it as a build arg.
VITE_API_BASE='https://in-de9c7b11c05f429faa157ace63cb4ffd.ecs.eu-west-1.on.aws/api/v1'

# Socket.IO origin, without the /api/v1 prefix. Derived from VITE_API_BASE when
# left blank, which holds whenever REST and the socket share a host.
# VITE_SOCKET_ORIGIN='http://localhost:9001'

# Socket.IO path. Defaults to /socket.io, which is where the spec mounts it.
# VITE_SOCKET_PATH='/socket.io'

# Run against the in-browser mock inbox instead of a backend. Never switches
# on by itself.
# VITE_USE_MOCK='true'

# Most inboxes one session may hold. Keep it equal to the backend's own cap.
# Defaults to 5.
# VITE_MAX_INBOXES='5'
